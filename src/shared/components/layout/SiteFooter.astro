---
/**
 * Minimal plain-text footer (DESIGN.md "Ma"): one row of links, one muted
 * credit line. Server-rendered; the DevTools easter egg is the only script.
 */
const year = new Date().getFullYear();

const LINKS = [
  { href: 'https://github.com/BubblePtr', label: 'GitHub', external: true },
  { href: 'https://twitter.com/ninthbit_ai', label: 'Twitter', external: true },
  { href: 'mailto:hi@kieran.build', label: 'Email', external: false },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<footer class="mx-auto max-w-[34rem] px-6 py-14">
  <div
    class="flex flex-col items-center gap-4 text-[0.8rem] text-zinc-500 sm:flex-row sm:justify-between dark:text-zinc-400"
  >
    <p class="m-0">© {year} Kieran Zhang</p>
    <nav class="flex items-center gap-5" aria-label="Footer">
      {
        LINKS.map((link) => (
          <a
            href={link.href}
            class="foot-link"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
  <p class="mt-3 text-center text-[0.7rem] text-zinc-400 sm:text-left dark:text-zinc-600">
    Illustrations from{' '}
    <a
      href="https://absurd.design/"
      target="_blank"
      rel="noopener noreferrer"
      class="foot-link"
    >absurd.design</a>{' '}
    by Diana Valeanu
  </p>
</footer>

<style>
  .foot-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    transition: color 150ms ease;
  }
  .foot-link:hover {
    color: var(--color-accent);
  }
</style>

<script is:inline>
  console.log(
    '%c Kieran Zhang ',
    'background:#18181b;color:#f4f4f5;font-size:13px;font-weight:600;padding:3px 8px;border-radius:3px;',
  );
  console.log(
    '%c Curious enough to open DevTools? Built with Astro 6 + React 19.  kieran.build/about',
    'color:#71717a;font-size:11px;',
  );
</script>
