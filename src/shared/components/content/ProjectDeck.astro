---
/**
 * Project deck (DESIGN.md v3 §5.1, decision in docs/design/decisions/project-deck.md).
 *
 * Objects on the desk: a fanned stack of project cards. Click lifts one
 * card to the top of the stage and the rest retreat beneath it while the
 * page scrolls to keep the whole arrangement centred in view; a second
 * click opens the project. Fewer than three projects falls back to the
 * plain grid, since a fan needs bodies to read as a stack. Rendered by
 * the home page's projects section.
 */
import type { ProjectListItem } from '@/types/content';

interface Props {
  projects: ProjectListItem[];
  /** Href for a card, given its slug. */
  href: (slug: string) => string;
  /** Hand-written line under the deck. English by design (DESIGN.md §3.2). */
  hint?: string;
}

const { projects, href, hint = 'Click a card to lift it. Click again to open the project.' } = Astro.props;
const n = projects.length;
const isDeck = n >= 3;
---

{
  isDeck ? (
    <div class="deck-stage" data-project-deck>
      <span class="deck-anchor" aria-hidden="true" />
      <ul class="deck" style={`--n:${n}`}>
        {projects.map((p, i) => (
          <li class="deck-item" style={`--i:${i}`}>
            <button
              type="button"
              class="deck-card focus-ring"
              data-cover={p.data.cover ?? 'ochre'}
              data-href={href(p.slug)}
              aria-expanded="false"
            >
              <span class="deck-cover">
                {p.data.heroImage ? (
                  <img src={p.data.heroImage} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="deck-blank" />
                )}
              </span>
              <span class="deck-meta">
                <span class="deck-title">{p.data.title}</span>
                {p.data.status && <span class="deck-status">{p.data.status}</span>}
              </span>
              <span class="deck-more">
                <span class="deck-desc">{p.data.description}</span>
                <span class="deck-cta">Open project →</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      {hint && <p class="deck-hint">{hint}</p>}
    </div>
  ) : (
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {projects.map((p) => (
        <a href={href(p.slug)} class="group block no-underline focus-ring">
          <span class="img-edge block aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-900">
            {p.data.heroImage && (
              <img
                src={p.data.heroImage}
                alt={p.data.title}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top"
              />
            )}
          </span>
          <span class="mt-2.5 flex items-baseline gap-2.5">
            <span class="deck-title min-w-0 truncate">{p.data.title}</span>
            {p.data.status && <span class="deck-status ml-auto shrink-0">{p.data.status}</span>}
          </span>
        </a>
      ))}
    </div>
  )
}

<style>
  .deck-stage {
    position: relative;
    --retreat: 380px;
    --lift-scale: 1.35;
    /* The one layout property we animate: a single element at the foot of the stage. */
    transition: padding-bottom 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .deck-stage[data-open] {
    padding-bottom: var(--retreat);
  }
  .deck-anchor {
    /* FLIP anchor: a lifted card's top edge lands here, centred. */
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 0;
  }

  .deck {
    list-style: none;
    margin: 0;
    padding: 24px 0 72px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }
  .deck-item {
    width: 240px;
    flex: 0 0 auto;
    margin-left: -56px;
    /* tilt grows outward from the centre card; outer cards sit lower */
    --k: calc(var(--i) - (var(--n) - 1) / 2);
    --rot: calc(var(--k) * 4deg);
    --dy: calc(max(var(--k), -1 * var(--k)) * 10px);
    z-index: var(--i);
  }
  .deck-item:first-child {
    margin-left: 0;
  }

  .deck-card {
    display: block;
    width: 100%;
    padding: 8px;
    border: 0;
    border-radius: 14px;
    background: var(--color-surface);
    box-shadow: var(--shadow-object);
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transform: rotate(var(--rot)) translateY(var(--dy));
    transform-origin: 50% 100%;
    transition:
      transform 320ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 320ms ease-out;
  }
  .deck-cover {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px; /* 14 − 8 */
    padding: 12px 12px 0;
    background: color-mix(in oklch, var(--cover) var(--cover-tint), var(--color-paper));
  }
  .deck-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 4px 4px 0 0;
    outline: 1px solid rgb(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  :global(.dark) .deck-cover img {
    outline-color: rgb(255 255 255 / 0.1);
  }
  .deck-blank {
    display: block;
    height: 100%;
    border-radius: 4px 4px 0 0;
    background: color-mix(in oklch, var(--cover) 40%, var(--color-paper));
  }
  .deck-meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 6px 4px;
  }
  .deck-title {
    font-family: var(--font-display);
    font-size: var(--font-size-display-md);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink-strong);
    min-width: 0;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .deck-status {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-accent);
  }
  .deck-more {
    display: block;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 150ms ease-out;
  }
  .deck-desc {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0 6px 6px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-secondary);
  }
  .deck-cta {
    display: block;
    margin: 4px 6px 8px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }
  .deck-hint {
    margin: -40px 0 0;
    text-align: center;
    font-family: var(--font-hand);
    font-size: 1.125rem;
    color: var(--color-ink-tertiary);
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1);
  }
  .deck-stage[data-open] .deck-hint {
    transform: translateY(var(--retreat));
  }

  [data-cover='vermilion'] { --cover: var(--color-cover-vermilion); }
  [data-cover='ochre'] { --cover: var(--color-cover-ochre); }
  [data-cover='gamboge'] { --cover: var(--color-cover-gamboge); }
  [data-cover='indigo'] { --cover: var(--color-cover-indigo); }
  [data-cover='dai'] { --cover: var(--color-cover-dai); }

  /* rest: hover only scales the card in place — z-index never changes on
     hover, so overlapped corners don't swap layers mid-gesture */
  @media (hover: hover) and (pointer: fine) {
    .deck-stage:not([data-open]) .deck-item:hover .deck-card {
      transform: rotate(var(--rot)) translateY(var(--dy)) scale(1.05);
      box-shadow: var(--shadow-object-raised);
    }
  }
  /* keyboard focus still raises the card so the ring isn't clipped by the next */
  .deck-stage:not([data-open]) .deck-item:focus-within { z-index: 100; }
  .deck-stage:not([data-open]) .deck-item:focus-within .deck-card {
    transform: rotate(var(--rot)) translateY(var(--dy)) scale(1.05);
    box-shadow: var(--shadow-object-raised);
  }

  /* open: the rest retreat down, toward the centre, smaller */
  .deck-stage[data-open] .deck-item:not([data-open]) .deck-card {
    transform: rotate(var(--rot)) translate(calc(var(--k) * -36px), calc(var(--dy) + var(--retreat))) scale(0.85);
  }
  @media (hover: hover) and (pointer: fine) {
    .deck-stage[data-open] .deck-item:not([data-open]):hover .deck-card {
      transform: rotate(var(--rot)) translate(calc(var(--k) * -36px), calc(var(--dy) + var(--retreat) - 6px)) scale(0.85);
    }
  }
  .deck-item[data-open] { z-index: 300; }
  .deck-item[data-open] .deck-card {
    /* --lx/--ly: measured by the script from the card's slot to the anchor */
    transform: translate(var(--lx), var(--ly)) rotate(0deg) scale(var(--lift-scale));
    transform-origin: 0 0;
    box-shadow: var(--shadow-object-raised);
  }
  .deck-item[data-open] .deck-more {
    max-height: 12rem;
    opacity: 1;
    transition: opacity 200ms ease-out 200ms;
  }

  /* entrance: once per page load, ≤4 staggered, 180ms (DESIGN.md §7) */
  .deck-item {
    animation: deck-rise 180ms cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: calc(min(var(--i, 0), 3) * 40ms);
  }
  @keyframes deck-rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 720px) {
    .deck {
      justify-content: flex-start;
      gap: 16px;
      padding: 8px 0 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .deck-item {
      width: 78vw;
      margin-left: 0;
      scroll-snap-align: start;
    }
    .deck-card,
    .deck-stage[data-open] .deck-item:not([data-open]) .deck-card,
    .deck-item[data-open] .deck-card {
      transform: none;
    }
    .deck-more { max-height: none; opacity: 1; }
    .deck-stage[data-open] { padding-bottom: 0; }
    .deck-anchor, .deck-hint { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .deck-item { animation: none; }
    .deck-stage, .deck-card, .deck-more, .deck-hint { transition: none; }
  }
</style>

<script>
  import { initProjectDecks } from './project-deck.client';

  initProjectDecks();
  document.addEventListener('astro:page-load', initProjectDecks);
</script>
