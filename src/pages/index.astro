---
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import DappledLight from '@/features/home/components/DappledLight.astro';
import { HomeLanding } from '@/features/home';
import { getUnifiedBlogList } from '@/features/blog/server';
import { getProjectsForHome } from '@/features/projects/server/queries.server';
import PageShell from '@/shared/components/layout/PageShell.astro';
import { getTranslationDictionary } from '@/shared/i18n/types';

const lang = 'en' as const;
const t = getTranslationDictionary(lang);
const [homePosts, homeProjects] = await Promise.all([
  getUnifiedBlogList(lang),
  getProjectsForHome(4),
]);
---

<PageShell lang={lang} title={SITE_TITLE} description={SITE_DESCRIPTION} currentPath="/">
  <link slot="head" rel="preload" as="image" href="https://cdn.ninthbit.org/avatar.jpg" />
  <DappledLight />
  <HomeLanding posts={homePosts} projects={homeProjects} lang={lang} t={t} />
</PageShell>
