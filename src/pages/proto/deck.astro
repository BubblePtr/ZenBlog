---
/**
 * PROTOTYPE — project deck exploration for DESIGN.md v3 §5.1.
 * Throwaway route. Nothing in production imports from here; delete after
 * the decision is written down (emil-prototype Phase 7).
 */
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { getUnifiedBlogList } from '@/features/blog/server';
import { getProjects } from '@/features/projects/server/queries.server';
import PageShell from '@/shared/components/layout/PageShell.astro';
import PostIndex from '@/shared/components/content/PostIndex.astro';
import { getTranslationDictionary } from '@/shared/i18n/types';

const lang = 'en' as const;
const t = getTranslationDictionary(lang);
const [posts, real] = await Promise.all([getUnifiedBlogList(lang), getProjects()]);

const covers: Record<string, string> = {
  pace: 'indigo',
  voily: 'vermilion',
  'awesome-pi': 'gamboge',
  subworth: 'dai',
};

// Worst content: a long name that wraps twice, no screenshot, long description.
const cards = [
  ...real.map((p) => ({
    slug: p.slug,
    title: p.data.title,
    description: p.data.description,
    heroImage: p.data.heroImage,
    status: p.data.status ?? 'building',
    cover: covers[p.slug] ?? 'ochre',
  })),
  {
    slug: 'worst',
    title: 'A Very Long Project Name That Wraps Twice',
    description:
      'An intentionally long one-line pitch that keeps going so we can see where the card clips it or lets it wrap.',
    heroImage: undefined,
    status: 'shipped' as const,
    cover: 'ochre',
  },
];
const n = cards.length;
const pageTitle = 'Proto · Deck | ' + SITE_TITLE;
---

<PageShell lang={lang} title={pageTitle} description={SITE_DESCRIPTION} currentPath="/proto/deck">
  <div class="relative z-10 mx-auto max-w-content px-6 pb-24 pt-24 sm:pt-28">
    <div class="flex items-center justify-between gap-6">
      <div class="min-w-0">
        <h1 class="font-display text-[2.5rem] leading-[1.1] tracking-[-0.01em] text-ink-strong">
          {t['home.hero.name']}
        </h1>
        <p class="mt-3 max-w-[26rem] text-sm leading-6 text-ink-secondary">{t['home.hero.bio']}</p>
      </div>
      <img src="/images/home/mac-light.webp" alt="" width="488" height="640" class="h-24 w-auto rounded-xl sm:h-28 dark:hidden" />
      <img src="/images/home/mac-dark.webp" alt="" width="488" height="640" class="hidden h-24 w-auto rounded-xl sm:h-28 dark:block" />
    </div>
    <section class="mt-16" aria-label="Writing">
      <PostIndex posts={posts.slice(0, 5)} lang={lang} />
    </section>
    <p class="mt-16 -mb-20 font-display text-[1.25rem] text-ink-strong">Projects</p>
  </div>

  <div id="stage" class="relative z-10 mx-auto max-w-stage px-6 pb-32"></div>

  <div class="mx-auto max-w-content px-6 pb-24 text-sm text-ink-tertiary">
    Text below the stage returns to the reading column.
  </div>

  <!-- Variant 1: Fan -->
  <template id="v-fan">
    <ul class="deck deck-fan" style={`--n:${n}`}>
      {
        cards.map((c, i) => (
          <li class="deck-item" style={`--i:${i}`}>
            <a href={`/projects/#${c.slug}`} class="card focus-ring" data-cover={c.cover}>
              <span class="card-cover">
                {c.heroImage ? <img src={c.heroImage} alt="" loading="lazy" /> : <span class="card-blank" />}
              </span>
              <span class="card-meta">
                <span class="card-title">{c.title}</span>
                <span class="card-status">{c.status}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </template>

  <!-- Variant 2: Spread -->
  <template id="v-spread">
    <ul class="deck deck-spread">
      {
        cards.map((c, i) => (
          <li class="deck-item" style={`--i:${i}`}>
            <a href={`/projects/#${c.slug}`} class="card focus-ring" data-cover={c.cover}>
              <span class="card-cover">
                {c.heroImage ? <img src={c.heroImage} alt="" loading="lazy" /> : <span class="card-blank" />}
              </span>
              <span class="card-meta">
                <span class="card-title">{c.title}</span>
                <span class="card-status">{c.status}</span>
              </span>
              <span class="card-desc">{c.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </template>

  <!-- Variant 3: Ledger -->
  <template id="v-ledger">
    <div class="ledger">
      <div class="ledger-feature" aria-hidden="true">
        {
          cards.map((c, i) => (
            <span class="ledger-cover" data-cover={c.cover} data-idx={i} data-active={i === 0 ? '' : undefined}>
              {c.heroImage ? <img src={c.heroImage} alt="" loading="lazy" /> : <span class="card-blank" />}
            </span>
          ))
        }
      </div>
      <ul class="ledger-list">
        {
          cards.map((c, i) => (
            <li style={`--i:${i}`}>
              <a href={`/projects/#${c.slug}`} class="ledger-row focus-ring" data-idx={i} data-active={i === 0 ? '' : undefined}>
                <span class="ledger-chip" data-cover={c.cover} />
                <span class="ledger-text">
                  <span class="card-title">{c.title}</span>
                  <span class="ledger-desc">{c.description}</span>
                </span>
                <span class="card-status">{c.status}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </template>

  <!-- Variant 4: Lift (fan + click to raise) -->
  <template id="v-lift">
    <div class="lift">
      <div class="lift-target" aria-hidden="true"></div>
      <ul class="deck deck-fan deck-lift" style={`--n:${n}`}>
        {
          cards.map((c, i) => (
            <li class="deck-item" style={`--i:${i}`}>
              <button type="button" class="card focus-ring" data-cover={c.cover} data-href={`/projects/#${c.slug}`} aria-expanded="false">
                <span class="card-cover">
                  {c.heroImage ? <img src={c.heroImage} alt="" loading="lazy" /> : <span class="card-blank" />}
                </span>
                <span class="card-meta">
                  <span class="card-title">{c.title}</span>
                  <span class="card-status">{c.status}</span>
                </span>
                <span class="card-more">
                  <span class="card-desc">{c.description}</span>
                  <span class="card-cta">Open project →</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p class="lift-hint">Click a card to lift it. Click again to open the project. Esc puts it back.</p>
    </div>
  </template>

  <!-- Picker (verbatim from emil-prototype/PICKER.md) -->
  <nav class="proto-picker" aria-label="Prototype variants">
    <span class="proto-picker-highlight" aria-hidden="true"></span>
    <button class="proto-picker-item" data-active aria-current="true">Fan</button>
    <button class="proto-picker-item">Spread</button>
    <button class="proto-picker-item">Ledger</button>
    <button class="proto-picker-item">Lift</button>
    <span class="proto-picker-divider" aria-hidden="true"></span>
    <button class="proto-picker-item proto-picker-replay" aria-label="Replay animation (R)">↻</button>
  </nav>
</PageShell>

<style>
  /* ============ shared card (DESIGN.md v3 §5.1) ============ */
  .deck {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card {
    display: block;
    width: 100%;
    padding: 8px;
    border-radius: 14px;
    background: var(--color-surface);
    box-shadow: var(--shadow-object);
    text-decoration: none;
    color: inherit;
    transition:
      transform 200ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 200ms ease-out;
  }
  .card-cover {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 6px; /* 14 − 8 */
    background: color-mix(in oklch, var(--cover) var(--cover-tint), var(--color-paper));
    padding: 12px 12px 0;
  }
  .card-cover img,
  .ledger-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 4px 4px 0 0;
    outline: 1px solid rgb(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  :global(.dark) .card-cover img,
  :global(.dark) .ledger-cover img {
    outline-color: rgb(255 255 255 / 0.1);
  }
  .card-blank {
    display: block;
    height: 100%;
    border-radius: 4px 4px 0 0;
    background: color-mix(in oklch, var(--cover) 40%, var(--color-paper));
  }
  .card-meta {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 6px 4px;
  }
  .card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-ink-strong);
    min-width: 0;
    text-wrap: balance;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-status {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--color-accent);
  }
  .card-desc,
  .ledger-desc {
    margin: 0 6px 6px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-secondary);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  [data-cover='vermilion'] { --cover: var(--color-cover-vermilion); }
  [data-cover='ochre'] { --cover: var(--color-cover-ochre); }
  [data-cover='gamboge'] { --cover: var(--color-cover-gamboge); }
  [data-cover='indigo'] { --cover: var(--color-cover-indigo); }
  [data-cover='dai'] { --cover: var(--color-cover-dai); }

  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      box-shadow: var(--shadow-object-raised);
    }
  }
  .card:focus-visible {
    box-shadow: var(--shadow-object-raised);
  }

  /* entrance: once per mount, ≤4 staggered, 180ms */
  .deck-item,
  .ledger-list li,
  .ledger-feature {
    animation: rise 180ms cubic-bezier(0.32, 0.72, 0, 1) both;
    animation-delay: calc(min(var(--i, 0), 3) * 40ms);
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .deck-item, .ledger-list li, .ledger-feature { animation: none; }
    .card, .ledger-cover { transition: none; }
  }

  /* ============ V1 Fan: overlapping, tilted, one card lifts ============ */
  .deck-fan {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    padding: 24px 0 72px;
  }
  .deck-fan .deck-item {
    width: 240px;
    flex: 0 0 auto;
    margin-left: -56px;
    /* tilt grows outward from the centre card; outer cards sit lower */
    --k: calc(var(--i) - (var(--n) - 1) / 2);
    --rot: calc(var(--k) * 4deg);
    --dy: calc(max(var(--k), -1 * var(--k)) * 10px);
    z-index: var(--i);
  }
  .deck-fan .deck-item:first-child { margin-left: 0; }
  .deck-fan .card {
    transform: rotate(var(--rot)) translateY(var(--dy));
    transform-origin: 50% 100%;
  }
  @media (hover: hover) and (pointer: fine) {
    .deck-fan .deck-item:hover { z-index: 100; }
    .deck-fan .deck-item:hover .card { transform: rotate(0deg) translateY(-8px); }
  }
  .deck-fan .deck-item:focus-within { z-index: 100; }
  .deck-fan .deck-item:focus-within .card { transform: rotate(0deg) translateY(-8px); }
  @media (max-width: 720px) {
    .deck-fan {
      justify-content: flex-start;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding: 16px 0 24px;
      scrollbar-width: none;
    }
    .deck-fan .deck-item { margin-left: 0; scroll-snap-align: start; width: 78vw; }
    .deck-fan .card { transform: none; }
  }

  /* ============ V2 Spread: laid flat side by side, no occlusion ============ */
  .deck-spread {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    padding: 16px 0 24px;
  }
  .deck-spread .deck-item {
    --rot: 1.2deg;
  }
  .deck-spread .deck-item:nth-child(even) { --rot: -1.2deg; }
  .deck-spread .card { transform: rotate(var(--rot)); }
  @media (hover: hover) and (pointer: fine) {
    .deck-spread .card:hover { transform: rotate(0deg) translateY(-6px); }
  }
  .deck-spread .card:focus-visible { transform: rotate(0deg) translateY(-6px); }
  @media (max-width: 720px) {
    .deck-spread {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .deck-spread .deck-item { flex: 0 0 78vw; scroll-snap-align: start; }
    .deck-spread .card { transform: none; }
  }

  /* ============ V3 Ledger: one feature, list drives it ============ */
  .ledger {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px;
    align-items: start;
    padding: 16px 0 24px;
  }
  .ledger-feature {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    background: var(--color-surface);
    box-shadow: var(--shadow-object);
    padding: 8px;
  }
  .ledger-cover {
    position: absolute;
    inset: 8px;
    border-radius: 6px;
    overflow: hidden;
    padding: 16px 16px 0;
    background: color-mix(in oklch, var(--cover) var(--cover-tint), var(--color-paper));
    opacity: 0;
    transition: opacity 150ms ease-out;
  }
  .ledger-cover[data-active] { opacity: 1; }
  .ledger-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .ledger-row {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: start;
    padding: 12px 8px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background-color 150ms ease-out;
  }
  .ledger-row[data-active] { background: color-mix(in oklch, var(--color-ink) 4%, transparent); }
  .ledger-chip {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: color-mix(in oklch, var(--cover) 70%, var(--color-paper));
    align-self: start;
    margin-top: 6px;
  }
  .ledger-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ledger-desc { padding: 0; }
  .ledger-list .card-status { margin-left: 0; align-self: center; }
  @media (max-width: 720px) {
    .ledger { grid-template-columns: 1fr; gap: 20px; }
  }

  /* ============ V4 Lift: fan, click raises a card into the stage ============ */
  .lift { position: relative; }
  .lift-target {
    /* where a lifted card lands: 360px wide, centred above the deck */
    width: 360px;
    height: 460px;
    margin: 0 auto;
  }
  .lift-hint {
    text-align: center;
    font-family: var(--font-hand);
    font-size: 1.125rem;
    color: var(--color-ink-tertiary);
    margin: -40px 0 0;
  }
  .deck-lift .card {
    font: inherit;
    text-align: left;
    cursor: pointer;
    border: 0;
    transform-origin: 50% 100%;
  }
  .deck-lift .card-more {
    display: block;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity 150ms ease-out;
  }
  .deck-lift .card-cta {
    display: block;
    margin: 4px 6px 8px;
    font-size: 0.8125rem;
    color: var(--color-accent);
  }
  .deck-lift .deck-item[data-open] { z-index: 300; }
  .deck-lift .deck-item[data-open] .card {
    /* --lx/--ly computed by JS from the card's deck slot to the target box */
    transform: translate(var(--lx), var(--ly)) rotate(0deg) scale(1.5);
    transform-origin: 0 0;
    box-shadow: var(--shadow-object-raised);
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1), box-shadow 320ms ease-out;
  }
  .deck-lift .deck-item[data-open] .card-more {
    max-height: 12rem;
    opacity: 1;
    transition: opacity 200ms ease-out 200ms;
  }
  .deck-lift .deck-item[data-open] .card-desc {
    -webkit-line-clamp: 3;
  }
  @media (hover: hover) and (pointer: fine) {
    .deck-lift .deck-item[data-open]:hover .card { transform: translate(var(--lx), var(--ly)) rotate(0deg) scale(1.5); }
  }
  .deck-lift .deck-item[data-open]:focus-within .card { transform: translate(var(--lx), var(--ly)) rotate(0deg) scale(1.5); }
  @media (max-width: 720px) {
    .lift-target { display: none; }
    .lift-hint { display: none; }
    .deck-lift .card-more { max-height: none; opacity: 1; }
    .deck-lift .deck-item[data-open] .card { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .deck-lift .deck-item[data-open] .card, .deck-lift .card-more { transition: none; }
  }

  /* ============ picker (verbatim) ============ */
  .proto-picker {
    position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 2147483647;
    display: flex; align-items: center; gap: 2px; padding: 4px; border-radius: 999px;
    background: rgba(10, 10, 10, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.4); backdrop-filter: blur(12px) saturate(1.4);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset, 0 8px 24px rgba(0, 0, 0, 0.24), 0 2px 6px rgba(0, 0, 0, 0.12);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 13px; line-height: 1;
    -webkit-font-smoothing: antialiased; user-select: none; -webkit-user-select: none;
  }
  .proto-picker-highlight { position: absolute; top: 4px; left: 0; height: 28px; border-radius: 999px; background: rgba(255, 255, 255, 0.12); will-change: transform; }
  .proto-picker[data-ready] .proto-picker-highlight { transition: transform 250ms cubic-bezier(0.23, 1, 0.32, 1), width 250ms cubic-bezier(0.23, 1, 0.32, 1); }
  @media (prefers-reduced-motion: reduce) { .proto-picker[data-ready] .proto-picker-highlight { transition: none; } }
  .proto-picker-item { position: relative; display: flex; align-items: center; height: 28px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: rgba(255, 255, 255, 0.55); font: inherit; cursor: pointer; transition: color 150ms ease-out; }
  .proto-picker-item:hover { color: rgba(255, 255, 255, 0.85); }
  .proto-picker-item:active { transform: scale(0.97); }
  .proto-picker-item:focus-visible { outline: 2px solid rgba(255, 255, 255, 0.4); outline-offset: 2px; }
  .proto-picker-item[data-active] { color: #fff; }
  .proto-picker-divider { width: 1px; height: 16px; margin: 0 4px; background: rgba(255, 255, 255, 0.12); }
  .proto-picker-replay { padding: 0 10px; font-size: 14px; }
</style>

<script src="./_deck.client.js"></script>
