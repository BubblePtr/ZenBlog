---
import { SITE_TITLE } from '@/consts';
import { getUnifiedBlogList } from '@/features/blog/server';
import PageShell from '@/shared/components/layout/PageShell.astro';
import PostIndex from '@/shared/components/content/PostIndex.astro';
import { getTranslationDictionary } from '@/shared/i18n/types';

const lang = 'zh' as const;
const t = getTranslationDictionary(lang);
const posts = await getUnifiedBlogList(lang);
---

<PageShell
  lang={lang}
  title={`${t['nav.blog']} | ${SITE_TITLE}`}
  description={t['blog.description']}
  currentPath="/zh/blog"
>
  <div class="mx-auto max-w-content px-6 pb-24 pt-16 sm:pt-20">
    <h1 class="text-[1.05rem] font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      {t['nav.blog']}
    </h1>
    <p class="mt-3 text-sm leading-6 text-zinc-500 dark:text-zinc-400">
      {t['blog.description']}
    </p>
    <div class="mt-12">
      <PostIndex posts={posts} lang={lang} />
    </div>
  </div>
</PageShell>
