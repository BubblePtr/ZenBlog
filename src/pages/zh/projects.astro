---
import { SITE_TITLE } from '@/consts';
import ProjectsPage from '@/features/projects/components/ProjectsPage.astro';
import { getProjects } from '@/features/projects/server/queries.server';
import PageShell from '@/shared/components/layout/PageShell.astro';
import { getTranslationDictionary } from '@/shared/i18n/types';

const lang = 'zh' as const;
const t = getTranslationDictionary(lang);
const projects = await getProjects();
---

<PageShell
  lang={lang}
  title={`${t['nav.projects']} | ${SITE_TITLE}`}
  description={t['projects.description']}
  currentPath="/zh/projects"
>
  <ProjectsPage projects={projects} lang={lang} t={t} />
</PageShell>
