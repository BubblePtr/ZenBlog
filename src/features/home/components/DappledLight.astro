---
/**
 * Dappled light overlay — a bamboo-grove shadow cast over the first screen.
 *
 * Pure static markup, zero JS. The grove is built bottom-up so every
 * silhouette stays physically connected: segmented culms rise through the
 * full frame with pronounced node breaks (gap + collar + a slight kink,
 * so the pole never reads as a smooth cylinder), short branches spring
 * from every node at ~40° upward — real bamboo foliage grows up and out,
 * hugging the culm — and leaf tufts fan from twig tips with blades
 * pointing up. Culms cluster unevenly (a close pair, then a gap) like a
 * real grove. Two layers at different blur depths sway around a pivot
 * below the frame (bamboo bends from its base); `multiply` blending
 * darkens the warm paper like a real shadow. Extends under the sticky
 * header so home nav and content share one field; sits under HomeLanding
 * (z-10). Hidden in dark mode; frozen under prefers-reduced-motion.
 */
---

<div class="dappled-light" aria-hidden="true">
  <div class="dappled-layer dappled-far">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- One bamboo leaf blade, tip pointing up (-y), stem end at origin -->
        <path
          id="leaf-far"
          d="M0 0 C 5 -10 8 -38 3 -88 C 1.5 -97 -1.5 -97 -3 -88 C -8 -38 -5 -10 0 0 Z"
        ></path>
        <!-- Leaf tuft at a twig tip: blades fan upward and outward -->
        <g id="tuft-far">
          <use href="#leaf-far" transform="rotate(14) scale(0.9)"></use>
          <use href="#leaf-far" transform="rotate(46)"></use>
          <use href="#leaf-far" transform="rotate(78) scale(0.85)"></use>
          <use href="#leaf-far" transform="rotate(-18) scale(0.7)"></use>
        </g>
        <!-- Short twig ending in one tuft, so leaves always hang off wood -->
        <g id="sprig-far">
          <path
            d="M0 0 C 8 -8 17 -14 28 -19"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            fill="none"
          ></path>
          <use href="#tuft-far" transform="translate(28 -19) rotate(8)"></use>
        </g>
        <!-- Branch as it leaves a culm node: short, rising ~40°, foliage
             packed along its whole length so leaves stay near the pole -->
        <g id="branch-far">
          <path
            d="M0 0 C 16 -18 34 -36 52 -50 C 64 -59 76 -66 90 -71"
            stroke="currentColor"
            stroke-width="3.5"
            stroke-linecap="round"
            fill="none"
          ></path>
          <use href="#sprig-far" transform="translate(12 -14) rotate(14) scale(0.7)"></use>
          <use href="#sprig-far" transform="translate(30 -33) rotate(6) scale(0.85)"></use>
          <use href="#sprig-far" transform="translate(58 -54) rotate(-8) scale(0.9)"></use>
          <use href="#tuft-far" transform="translate(90 -71) rotate(10) scale(1.05)"></use>
        </g>
        <!-- Segmented culm, base at origin rising ~990. Each internode
             starts slightly offset from where the last one ended (the
             kink at a real node) and a collar band bridges the gap, so
             the node rhythm survives the blur. Drawn darker than the
             foliage so the pole reads as the grove's signature. -->
        <g id="culm-far" stroke="oklch(0.34 0.02 60)" fill="oklch(0.34 0.02 60)">
          <path
            d="M 0 0 C 4 -75 8 -150 12 -222 M 10 -246 C 12 -312 14 -380 15 -442 M 18 -466 C 22 -530 27 -594 30 -648 M 28 -672 C 29 -722 30 -774 30 -818 M 33 -842 C 35 -890 36 -940 37 -992"
            stroke-width="32"
            stroke-linecap="round"
            fill="none"
          ></path>
          <ellipse cx="11" cy="-234" rx="24" ry="7"></ellipse>
          <ellipse cx="16.5" cy="-454" rx="23" ry="7"></ellipse>
          <ellipse cx="29" cy="-660" rx="22" ry="6.5"></ellipse>
          <ellipse cx="31.5" cy="-830" rx="21.5" ry="6.5"></ellipse>
        </g>
        <!-- One whole plant: culm plus a short branch at every node,
             alternating sides, so foliage hugs the pole top to bottom -->
        <g id="bamboo-far">
          <use href="#culm-far"></use>
          <use href="#sprig-far" transform="translate(11 -240) rotate(-12) scale(1.15)"></use>
          <use href="#branch-far" transform="translate(16 -460) scale(-1 1)"></use>
          <use href="#branch-far" transform="translate(29 -666) rotate(-8)"></use>
          <use href="#branch-far" transform="translate(31 -836) scale(-0.9 0.9) rotate(6)"></use>
        </g>
      </defs>
      <!-- Warm neutral (hue ~60) so multiply matches the paper, not cool zinc -->
      <g fill="oklch(0.42 0.02 60)" color="oklch(0.42 0.02 60)">
        <use href="#bamboo-far" transform="translate(130 980) rotate(2) scale(1.5)"></use>
        <use href="#bamboo-far" transform="translate(520 990) scale(-1.4 1.4) rotate(-2.5)"></use>
        <use href="#bamboo-far" transform="translate(1010 975) rotate(1.5) scale(1.6)"></use>
        <use href="#bamboo-far" transform="translate(1330 990) scale(-1.5 1.5) rotate(-3)"></use>
      </g>
    </svg>
  </div>
  <div class="dappled-layer dappled-near">
    <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <!-- Near blades run ~1.3x the far ones: the close layer carries the
             recognizable leaf shapes, so they must survive the blur -->
        <path
          id="leaf-near"
          d="M0 0 C 6.5 -13 10 -49 4 -114 C 2 -126 -2 -126 -4 -114 C -10 -49 -6.5 -13 0 0 Z"
        ></path>
        <g id="tuft-near">
          <use href="#leaf-near" transform="rotate(14) scale(0.9)"></use>
          <use href="#leaf-near" transform="rotate(46)"></use>
          <use href="#leaf-near" transform="rotate(78) scale(0.85)"></use>
          <use href="#leaf-near" transform="rotate(-18) scale(0.7)"></use>
        </g>
        <g id="sprig-near">
          <path
            d="M0 0 C 8 -8 17 -14 28 -19"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            fill="none"
          ></path>
          <use href="#tuft-near" transform="translate(28 -19) rotate(8)"></use>
        </g>
        <g id="branch-near">
          <path
            d="M0 0 C 16 -18 34 -36 52 -50 C 64 -59 76 -66 90 -71"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            fill="none"
          ></path>
          <use href="#sprig-near" transform="translate(12 -14) rotate(14) scale(0.7)"></use>
          <use href="#sprig-near" transform="translate(30 -33) rotate(6) scale(0.85)"></use>
          <use href="#sprig-near" transform="translate(58 -54) rotate(-8) scale(0.9)"></use>
          <use href="#tuft-near" transform="translate(90 -71) rotate(10) scale(1.05)"></use>
        </g>
        <g id="culm-near" stroke="oklch(0.40 0.025 70)" fill="oklch(0.40 0.025 70)">
          <path
            d="M 0 0 C 4 -75 8 -150 12 -222 M 10 -246 C 12 -312 14 -380 15 -442 M 18 -466 C 22 -530 27 -594 30 -648 M 28 -672 C 29 -722 30 -774 30 -818 M 33 -842 C 35 -890 36 -940 37 -992"
            stroke-width="22"
            stroke-linecap="round"
            fill="none"
          ></path>
          <ellipse cx="11" cy="-234" rx="17.5" ry="5.5"></ellipse>
          <ellipse cx="16.5" cy="-454" rx="17" ry="5.5"></ellipse>
          <ellipse cx="29" cy="-660" rx="16.5" ry="5"></ellipse>
          <ellipse cx="31.5" cy="-830" rx="16" ry="5"></ellipse>
        </g>
        <g id="bamboo-near">
          <use href="#culm-near"></use>
          <use href="#sprig-near" transform="translate(11 -240) rotate(-12) scale(1.15)"></use>
          <use href="#branch-near" transform="translate(16 -460) scale(-1 1)"></use>
          <use href="#branch-near" transform="translate(29 -666) rotate(-8)"></use>
          <use href="#branch-near" transform="translate(31 -836) scale(-0.9 0.9) rotate(6)"></use>
        </g>
      </defs>
      <g fill="oklch(0.48 0.025 70)" color="oklch(0.48 0.025 70)">
        <!-- A close pair on the open paper left of the content column —
             uneven spacing is what makes it read as a grove -->
        <use href="#bamboo-near" transform="translate(415 985) rotate(-2) scale(1.05)"></use>
        <use href="#bamboo-near" transform="translate(545 995) scale(-0.92 0.92) rotate(2.5)"></use>
        <!-- Lone culm along the right edge, leaning the other way -->
        <use href="#bamboo-near" transform="translate(1390 990) scale(-1.12 1.12) rotate(3)"></use>
      </g>
    </svg>
  </div>
</div>

<style>
  .dappled-light {
    /* Cover the first screen including the sticky header strip (h-16),
       so the transparent home nav and content share one paper field.
       Scrolls away with main; fades before the dense list. z-0 sits under
       HomeLanding (z-10) so shadows multiply onto paper, not type. */
    position: absolute;
    top: -4rem;
    left: 0;
    right: 0;
    height: calc(100vh + 4rem);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    mix-blend-mode: multiply;
    /* Long eased dissolve: the shadow is the edge of a pool of light, so
       it must melt away over the lower half instead of being chopped off
       when the hero scrolls past */
    mask-image: linear-gradient(
      to bottom,
      black 45%,
      rgba(0, 0, 0, 0.72) 62%,
      rgba(0, 0, 0, 0.38) 78%,
      rgba(0, 0, 0, 0.14) 90%,
      transparent 100%
    );
  }

  /* Gray shadows multiplied onto near-black do nothing but smear — skip at night */
  :global(.dark) .dappled-light {
    display: none;
  }

  .dappled-layer {
    /* Bleed past the viewport so blur never reveals a hard SVG edge */
    position: absolute;
    inset: -12%;
    will-change: transform;
  }

  .dappled-layer svg {
    width: 100%;
    height: 100%;
  }

  /* Far culms: heavier blur, fainter, slower — the grove a few paces back */
  .dappled-far {
    filter: blur(38px);
    opacity: 0.14;
    transform-origin: 50% 115%;
    animation: dappled-sway 13s ease-in-out infinite alternate;
  }

  /* Near culms: crisper, darker, quicker — the stalks closest to the paper */
  .dappled-near {
    filter: blur(10px);
    opacity: 0.16;
    transform-origin: 50% 125%;
    animation: dappled-sway 8.5s ease-in-out -4s infinite alternate-reverse;
  }

  /* Pivot sits below the frame: bamboo bends from its base, so tops sweep
     furthest while the rooted culms barely shift */
  @keyframes dappled-sway {
    from {
      transform: rotate(-0.5deg) skewX(0.35deg);
    }
    to {
      transform: rotate(0.65deg) skewX(-0.45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dappled-layer {
      animation: none;
    }
  }
</style>
