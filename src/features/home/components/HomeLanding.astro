---
/**
 * Minimal writing-first landing: identity line, year-grouped post index,
 * a small project grid, and a plain-text footer. Server-rendered only —
 * the section ships zero client JS by design (motion budget is spent on
 * the DappledLight overlay alone).
 */
import type { BlogListItem, ProjectListItem } from '@/types/content';
import type { Language } from '@/i18n/config';
import type { TranslationDictionary, TranslationKey } from '@/shared/i18n/types';
import PostIndex from '@/shared/components/content/PostIndex.astro';
import ProjectDeck from '@/shared/components/content/ProjectDeck.astro';
import { withTrailingSlash } from '@/shared/urls';

interface Props {
  posts: BlogListItem[];
  projects: ProjectListItem[];
  lang: Language;
  t: TranslationDictionary;
}

const { posts, projects, lang, t } = Astro.props;
const translate = (key: TranslationKey) => t[key] || key;
const isZh = lang === 'zh';

const projectsHref = withTrailingSlash(isZh ? '/zh/projects' : '/projects');
const projectHref = (slug: string) => `${projectsHref}#${slug}`;

const blogHref = withTrailingSlash(isZh ? '/zh/blog' : '/blog');

/* Home shows only the newest posts; the full year-grouped index lives on
   the blog page. A count, not a year, so January never leaves home empty. */
const HOME_POST_LIMIT = 8;
const homePosts = posts.slice(0, HOME_POST_LIMIT);
const hasMorePosts = posts.length > homePosts.length;
const photosHref = withTrailingSlash(isZh ? '/zh/photography' : '/photography');
const aboutHref = withTrailingSlash(isZh ? '/zh/about' : '/about');

/* Annotated navigation (DESIGN.md v3 §5.2): the prose is the home page's
   nav; each entry word is a link, the note beside it is the aside. Notes
   stay English on both locales. Project counts come from the collection. */
const building = projects.filter((p) => p.data.status === 'building').length;
const shipped = projects.length - building;
const notes = {
  projects: building > 0 ? `${shipped} shipped, ${building} still building` : `${shipped} shipped`,
  writing: 'mostly in Chinese',
  photos: 'film + digital',
  about: 'indie since Jun 2026',
};
---

<div class="home-min relative z-10 mx-auto max-w-content px-6 pb-24 pt-24 sm:pt-28">
  {/* Identity: text block on the page's left axis (shared with every post
      title below), Macintosh accent anchored to the right axis (shared with
      the date column) — the hero mirrors the list rows' left-text/right-meta
      rhythm. The Mac replaces the avatar (kept on the About page); light/dark
      renders are both in the DOM and swapped via the dark: variant so a theme
      toggle switches them instantly, under the theme cross-fade. */}
  <div class="flex items-center justify-between gap-6">
    <div class="min-w-0">
      <h1 class="display-xl">{translate('home.hero.name')}</h1>
    </div>
    <div class="shrink-0" aria-hidden="true">
      <img
        src="/images/home/mac-light.webp"
        alt=""
        width="488"
        height="640"
        loading="eager"
        fetchpriority="high"
        class="h-24 w-auto select-none rounded-xl sm:h-28 dark:hidden"
        draggable="false"
      />
      <img
        src="/images/home/mac-dark.webp"
        alt=""
        width="488"
        height="640"
        loading="eager"
        class="hidden h-24 w-auto select-none rounded-xl sm:h-28 dark:block"
        draggable="false"
      />
    </div>
  </div>

  <nav class="ann-nav" aria-label={translate('home.projects')}>
    {
      isZh ? (
        <>
          <p>我叫 Kieran，一个独立开发者，手上有几件 <a class="ann ann-se ann-blue" style="--ann-delay: 0ms" data-note={notes.projects} href={projectsHref}><span class="ann-word">小产品</span></a>，也攒了一些关于 agentic 工程的 <a class="ann ann-sw ann-green" style="--ann-delay: 250ms" data-note={notes.writing} href={blogHref}><span class="ann-word">文章</span></a>。</p>
          <p>出门总带着一台 <a class="ann ann-ne ann-amber" style="--ann-delay: 500ms" data-note={notes.photos} href={photosHref}><span class="ann-word">相机</span></a>，剩下的，在 <a class="ann ann-nw ann-purple" style="--ann-delay: 750ms" data-note={notes.about} href={aboutHref}><span class="ann-word">自我介绍</span></a> 里慢慢说。</p>
        </>
      ) : (
        <>
          <p>I'm Kieran, an indie developer with a few <a class="ann ann-se ann-blue" style="--ann-delay: 0ms" data-note={notes.projects} href={projectsHref}><span class="ann-word">small products</span></a> in the wild and some <a class="ann ann-sw ann-green" style="--ann-delay: 250ms" data-note={notes.writing} href={blogHref}><span class="ann-word">writing</span></a> on agentic engineering.</p>
          <p>A <a class="ann ann-n ann-amber" style="--ann-delay: 500ms" data-note={notes.photos} href={photosHref}><span class="ann-word">camera</span></a> comes along whenever I leave the desk, and the rest is on the <a class="ann ann-nw ann-purple" style="--ann-delay: 750ms" data-note={notes.about} href={aboutHref}><span class="ann-word">about page</span></a>.</p>
        </>
      )
    }
  </nav>

  {/* Writing index, grouped by year */}
  <section class="mt-16">
    <h2 class="display-md">{translate('home.writing')}</h2>
    <div class="mt-5">
      <PostIndex posts={homePosts} lang={lang} />
    </div>
    {
      hasMorePosts && (
        <a href={blogHref} class="view-all focus-ring">
          {translate('home.viewAll')} →
        </a>
      )
    }
  </section>

  {/* Projects: objects on the desk (DESIGN.md v3 §5.1). The stage breaks out
      of the reading column; the label above stays on it. */}
  {
    projects.length > 0 && (
      <section class="mt-16">
        <h2 class="display-md">{translate('home.projects')}</h2>
        <div class="deck-breakout mt-3">
          <ProjectDeck projects={projects} href={projectHref} />
        </div>
      </section>
    )
  }

</div>

<style>
  /* The prose nav: two centred lines on the stage width. Line 1 carries its
     labels above, line 2 below, so the lines stay together. Labels are
     pseudo-elements that reserve no space: the block's margins hold the room.
     Entrance (DESIGN.md §7): the four notes appear one after another, 200ms
     each, arrow and label only; the words themselves never animate. */
  .ann-nav {
    margin: 4.75rem auto 4.5rem;
    width: min(var(--container-stage), 100vw - 3rem);
    margin-left: calc(50% - min(var(--container-stage), 100vw - 3rem) / 2);
    text-align: center;
  }
  .ann-nav p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink);
  }
  /* Entrance, after the neat-annotations demo: the mark swipes in, the arrow
     draws itself from the label end toward the word, then the label fades.
     One 0.9s sequence per note, staggered by --ann-delay. Marks drawn with a
     background gradient so their width can animate; the library's ±0.3em
     box-shadow extension is dropped on home for that. */
  .ann-nav .ann {
    --ann-clip-from: inset(0 100% 0 0);
    background: linear-gradient(var(--ann-mark), var(--ann-mark)) left center / 0 100% no-repeat;
    box-shadow: none;
    animation: ann-mark-swipe 900ms linear both;
    animation-delay: calc(300ms + var(--ann-delay, 0ms));
  }
  /* arrows that leave from the right-hand label draw right-to-left */
  .ann-nav .ann-sw,
  .ann-nav .ann-nw,
  .ann-nav .ann-w {
    --ann-clip-from: inset(0 0 0 100%);
  }
  .ann-nav .ann::before {
    animation: ann-arrow-draw 900ms linear both;
    animation-delay: calc(300ms + var(--ann-delay, 0ms));
  }
  .ann-nav .ann::after {
    animation: ann-label-reveal 900ms linear both;
    animation-delay: calc(300ms + var(--ann-delay, 0ms));
  }
  @keyframes ann-mark-swipe {
    0% {
      background-size: 0 100%;
    }
    22%,
    100% {
      background-size: 100% 100%;
    }
  }
  @keyframes ann-arrow-draw {
    0%,
    24% {
      clip-path: var(--ann-clip-from);
      opacity: 0;
    }
    27% {
      opacity: 0.9;
    }
    58%,
    100% {
      clip-path: inset(0);
      opacity: 0.9;
    }
  }
  @keyframes ann-label-reveal {
    0%,
    62% {
      opacity: 0;
    }
    84%,
    100% {
      opacity: 0.9;
    }
  }
  /* Hover: the annotation gets restless (DESIGN.md §7). Arrow and label rock
     slowly, quicken, then buzz, the frequency stepping up in three stages.
     The trigger zone is the annotation itself, not the word: the library sets
     pointer-events:none on the pseudo-elements, so here they get auto, which
     makes hovering (and clicking) the arrow or label count as hovering the
     link. :not(:has(.ann-word:hover)) then filters out hover arriving via the
     word span, so hovering the word only tints it while hovering the
     annotation shakes it; keyboard focus keeps the shake as its equivalent.
     The jitter animations are appended after the entrance animation in the
     same list: a name already in the list keeps its finished state, so the
     entrance never replays when hover starts or ends. Motion uses the
     standalone rotate/translate properties, which compose on top of the
     library's positioning transforms. */
  .ann-nav .ann::before,
  .ann-nav .ann::after {
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .ann-nav .ann:hover:not(:has(.ann-word:hover))::before,
    .ann-nav .ann:focus-visible::before {
      animation:
        ann-arrow-draw 900ms linear both,
        ann-jitter-sway 400ms ease-in-out 2,
        ann-jitter-quicken 200ms ease-in-out 3,
        ann-jitter-buzz 110ms linear infinite;
      animation-delay:
        calc(300ms + var(--ann-delay, 0ms)),
        0ms,
        800ms,
        1.4s;
    }
    .ann-nav .ann:hover:not(:has(.ann-word:hover))::after,
    .ann-nav .ann:focus-visible::after {
      animation:
        ann-label-reveal 900ms linear both,
        ann-jitter-sway 400ms ease-in-out 2,
        ann-jitter-quicken 200ms ease-in-out 3,
        ann-jitter-buzz 110ms linear infinite;
      animation-delay:
        calc(300ms + var(--ann-delay, 0ms)),
        0ms,
        800ms,
        1.4s;
    }
  }
  @keyframes ann-jitter-sway {
    0%,
    100% {
      rotate: 0deg;
    }
    25% {
      rotate: 0.8deg;
    }
    75% {
      rotate: -0.8deg;
    }
  }
  @keyframes ann-jitter-quicken {
    0%,
    100% {
      rotate: 0deg;
      translate: 0 0;
    }
    25% {
      rotate: 1.1deg;
      translate: 0.3px 0;
    }
    75% {
      rotate: -1.1deg;
      translate: -0.3px 0;
    }
  }
  @keyframes ann-jitter-buzz {
    0%,
    100% {
      rotate: 0deg;
      translate: 0 0;
    }
    25% {
      rotate: 1.5deg;
      translate: 0.4px -0.2px;
    }
    50% {
      rotate: 0deg;
      translate: 0 0.2px;
    }
    75% {
      rotate: -1.5deg;
      translate: -0.4px -0.2px;
    }
  }
  @media (max-width: 720px) {
    .ann-nav {
      margin: 2.5rem 0 0;
      width: auto;
      text-align: left;
    }
    .ann-nav .ann::before,
    .ann-nav .ann::after {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ann-nav .ann,
    .ann-nav .ann::before,
    .ann-nav .ann::after {
      animation: none;
    }
    .ann-nav .ann {
      background-size: 100% 100%;
    }
  }

  /* View-all: a list row's quiet sibling, in the wayfinding colour. */
  .view-all {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.25rem 0;
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
  }
  .view-all:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .group:hover .post-title {
    color: var(--color-accent);
  }

  /* Stage width (--container-stage) centred on the reading column. */
  .deck-breakout {
    width: min(var(--container-stage), 100vw - 3rem);
    margin-left: calc(50% - min(var(--container-stage), 100vw - 3rem) / 2);
  }

</style>
