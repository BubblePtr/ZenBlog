---
/**
 * Minimal writing-first landing: identity line, year-grouped post index,
 * a small project grid, and a plain-text footer. Server-rendered only —
 * the section ships zero client JS by design (motion budget is spent on
 * the DappledLight overlay alone).
 */
import type { BlogListItem, ProjectListItem } from '@/types/content';
import type { Language } from '@/i18n/config';
import type { TranslationDictionary, TranslationKey } from '@/shared/i18n/types';
import PostIndex from '@/shared/components/content/PostIndex.astro';
import { withTrailingSlash } from '@/shared/urls';

interface Props {
  posts: BlogListItem[];
  projects: ProjectListItem[];
  lang: Language;
  t: TranslationDictionary;
}

const { posts, projects, lang, t } = Astro.props;
const translate = (key: TranslationKey) => t[key] || key;
const isZh = lang === 'zh';

const AVATAR_URL = 'https://cdn.ninthbit.org/avatar.jpg';
const projectsHref = withTrailingSlash(isZh ? '/zh/projects' : '/projects');
---

<div class="home-min mx-auto max-w-[34rem] px-6 pb-24 pt-24 sm:pt-28">
  {/* Identity */}
  <div class="flex items-center gap-3.5">
    <div
      class="h-11 w-11 shrink-0 overflow-hidden rounded-full"
      style="view-transition-name: hero-avatar"
    >
      <img
        src={AVATAR_URL}
        alt={translate('home.hero.name')}
        width="44"
        height="44"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
      />
    </div>
    <h1 class="text-[1.05rem] font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      {translate('home.hero.name')}
    </h1>
  </div>
  <p class="mt-3 max-w-[26rem] text-sm leading-6 text-zinc-500 dark:text-zinc-400">
    {translate('home.hero.bio')}
  </p>

  {/* Writing index, grouped by year */}
  <section class="mt-16" aria-label={translate('home.writing')}>
    <PostIndex posts={posts} lang={lang} />
  </section>

  {/* Projects */}
  {
    projects.length > 0 && (
      <section class="mt-16" aria-label={translate('home.projects')}>
        <p class="year-label">{translate('home.projects')}</p>
        <div class="mt-3 grid grid-cols-1 gap-5 sm:grid-cols-2">
          {projects.map((project) => (
            <a href={projectsHref} class="group block no-underline focus-ring">
              <span class="block aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-900">
                {project.data.heroImage && (
                  <img
                    src={project.data.heroImage}
                    alt={project.data.title}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-[400ms] ease-out group-hover:scale-[1.03]"
                  />
                )}
              </span>
              <span class="mt-2.5 flex items-baseline gap-2.5">
                <span class="post-title min-w-0 truncate text-[0.9375rem] font-semibold tracking-tight text-zinc-900 transition-colors dark:text-zinc-100">
                  {project.data.title}
                </span>
                {project.data.status && (
                  <span class="project-status ml-auto shrink-0 font-mono text-[0.65rem]">
                    {project.data.status}
                  </span>
                )}
              </span>
              <span class="mt-0.5 block truncate text-[0.8125rem] text-zinc-500 dark:text-zinc-400">
                {project.data.description}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

</div>

<style>
  /* Accent comes from the site-wide bamboo token (--color-accent). */
  .year-label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-tertiary, #b3b3ae);
  }

  .group:hover .post-title {
    color: var(--color-accent);
  }

  .project-status {
    color: var(--color-accent);
  }

</style>
