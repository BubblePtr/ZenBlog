---
/**
 * Minimal writing-first landing: identity line, year-grouped post index,
 * a small project grid, and a plain-text footer. Server-rendered only —
 * the section ships zero client JS by design (motion budget is spent on
 * the DappledLight overlay alone).
 */
import type { BlogListItem, ProjectListItem } from '@/types/content';
import type { Language } from '@/i18n/config';
import type { TranslationDictionary, TranslationKey } from '@/shared/i18n/types';
import PostIndex from '@/shared/components/content/PostIndex.astro';
import ProjectDeck from '@/shared/components/content/ProjectDeck.astro';
import { withTrailingSlash } from '@/shared/urls';

interface Props {
  posts: BlogListItem[];
  projects: ProjectListItem[];
  lang: Language;
  t: TranslationDictionary;
}

const { posts, projects, lang, t } = Astro.props;
const translate = (key: TranslationKey) => t[key] || key;
const isZh = lang === 'zh';

const projectsHref = withTrailingSlash(isZh ? '/zh/projects' : '/projects');
const projectHref = (slug: string) => `${projectsHref}#${slug}`;

const blogHref = withTrailingSlash(isZh ? '/zh/blog' : '/blog');
const photosHref = withTrailingSlash(isZh ? '/zh/photography' : '/photography');
const aboutHref = withTrailingSlash(isZh ? '/zh/about' : '/about');

/* Annotated navigation (DESIGN.md v3 §5.2): the prose is the home page's
   nav; each entry word is a link, the note beside it is the aside. Notes
   stay English on both locales. Project counts come from the collection. */
const building = projects.filter((p) => p.data.status === 'building').length;
const shipped = projects.length - building;
const notes = {
  projects: building > 0 ? `${shipped} shipped, ${building} still building` : `${shipped} shipped`,
  writing: 'mostly in Chinese',
  photos: 'film + digital',
  about: 'indie since Jun 2026',
};
---

<div class="home-min relative z-10 mx-auto max-w-content px-6 pb-24 pt-24 sm:pt-28">
  {/* Identity: text block on the page's left axis (shared with every post
      title below), Macintosh accent anchored to the right axis (shared with
      the date column) — the hero mirrors the list rows' left-text/right-meta
      rhythm. The Mac replaces the avatar (kept on the About page); light/dark
      renders are both in the DOM and swapped via the dark: variant so a theme
      toggle switches them instantly, under the theme cross-fade. */}
  <div class="flex items-center justify-between gap-6">
    <div class="min-w-0">
      <h1 class="display-xl">{translate('home.hero.name')}</h1>
    </div>
    <div class="shrink-0" aria-hidden="true">
      <img
        src="/images/home/mac-light.webp"
        alt=""
        width="488"
        height="640"
        loading="eager"
        fetchpriority="high"
        class="h-24 w-auto select-none rounded-xl sm:h-28 dark:hidden"
        draggable="false"
      />
      <img
        src="/images/home/mac-dark.webp"
        alt=""
        width="488"
        height="640"
        loading="eager"
        class="hidden h-24 w-auto select-none rounded-xl sm:h-28 dark:block"
        draggable="false"
      />
    </div>
  </div>

  <nav class="ann-nav mt-10" aria-label={translate('home.projects')}>
    {
      isZh ? (
        <>
          <p>我是 Kieran，在南京的 AI-native 独立开发者。</p>
          <p>我在做几件 <a class="ann ann-w ann-blue" data-note={notes.projects} href={projectsHref}>小产品</a>。</p>
          <p class="ann-room">也 <a class="ann ann-n ann-green" data-note={notes.writing} href={blogHref}>写</a> 一些关于 agentic 工程和独自造东西的文章。</p>
          <p>离开书桌的时候，会带上 <a class="ann ann-w ann-amber" data-note={notes.photos} href={photosHref}>相机</a>。</p>
          <p>还有一点 <a class="ann ann-n ann-purple" data-note={notes.about} href={aboutHref}>关于我</a> 的事。</p>
        </>
      ) : (
        <>
          <p>I'm Kieran, an AI-native indie builder in Nanjing.</p>
          <p>I ship <a class="ann ann-w ann-blue" data-note={notes.projects} href={projectsHref}>small products</a>.</p>
          <p class="ann-room">I <a class="ann ann-n ann-green" data-note={notes.writing} href={blogHref}>write</a> about agentic engineering and building alone.</p>
          <p>When I leave the desk, I carry a <a class="ann ann-w ann-amber" data-note={notes.photos} href={photosHref}>camera</a>.</p>
          <p>There is a little more <a class="ann ann-n ann-purple" data-note={notes.about} href={aboutHref}>about me</a>.</p>
        </>
      )
    }
  </nav>

  {/* Writing index, grouped by year */}
  <section class="mt-16">
    <h2 class="display-md">{translate('home.writing')}</h2>
    <div class="mt-5">
      <PostIndex posts={posts} lang={lang} />
    </div>
  </section>

  {/* Projects: objects on the desk (DESIGN.md v3 §5.1). The stage breaks out
      of the reading column; the label above stays on it. */}
  {
    projects.length > 0 && (
      <section class="mt-16">
        <h2 class="display-md">{translate('home.projects')}</h2>
        <div class="deck-breakout mt-3">
          <ProjectDeck projects={projects} href={projectHref} />
        </div>
      </section>
    )
  }

</div>

<style>
  /* The prose nav: one entry per line so every note has room. Labels are
     pseudo-elements that reserve no space (library note), so the line with
     a note below it gets explicit room. */
  .ann-nav p {
    margin: 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-ink);
  }
  .ann-nav .ann-room {
    margin-bottom: 3.25rem;
  }
  .ann-nav p:last-child {
    margin-bottom: 3rem;
  }
  @media (max-width: 720px) {
    .ann-nav .ann::before,
    .ann-nav .ann::after {
      display: none;
    }
    .ann-nav .ann-room,
    .ann-nav p:last-child {
      margin-bottom: 0;
    }
  }

  .group:hover .post-title {
    color: var(--color-accent);
  }

  /* Stage width (--container-stage) centred on the reading column. */
  .deck-breakout {
    width: min(var(--container-stage), 100vw - 3rem);
    margin-left: calc(50% - min(var(--container-stage), 100vw - 3rem) / 2);
  }

</style>
