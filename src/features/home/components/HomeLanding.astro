---
/**
 * Minimal writing-first landing: identity line, year-grouped post index,
 * a small project grid, and a plain-text footer. Server-rendered only —
 * the section ships zero client JS by design (motion budget is spent on
 * the DappledLight overlay alone).
 */
import type { BlogListItem, ProjectListItem } from '@/types/content';
import type { Language } from '@/i18n/config';
import type { TranslationDictionary, TranslationKey } from '@/shared/i18n/types';
import PostIndex from '@/shared/components/content/PostIndex.astro';
import ProjectDeck from '@/shared/components/content/ProjectDeck.astro';
import { withTrailingSlash } from '@/shared/urls';

interface Props {
  posts: BlogListItem[];
  projects: ProjectListItem[];
  lang: Language;
  t: TranslationDictionary;
}

const { posts, projects, lang, t } = Astro.props;
const translate = (key: TranslationKey) => t[key] || key;
const isZh = lang === 'zh';

const projectsHref = withTrailingSlash(isZh ? '/zh/projects' : '/projects');
const projectHref = (slug: string) => `${projectsHref}#${slug}`;

/* The one unanchored hand-written aside on the site (DESIGN.md §5.3). */
const signature = 'indie since Jun 2026';
---

<div class="home-min relative z-10 mx-auto max-w-content px-6 pb-24 pt-24 sm:pt-28">
  {/* Identity: text block on the page's left axis (shared with every post
      title below), Macintosh accent anchored to the right axis (shared with
      the date column) — the hero mirrors the list rows' left-text/right-meta
      rhythm. The Mac replaces the avatar (kept on the About page); light/dark
      renders are both in the DOM and swapped via the dark: variant so a theme
      toggle switches them instantly, under the theme cross-fade. */}
  <div class="flex items-center justify-between gap-6">
    <div class="min-w-0">
      <h1 class="display-xl">{translate('home.hero.name')}</h1>
      <p class="mt-3 max-w-[26rem] text-sm leading-6 text-zinc-500 dark:text-zinc-400">
        {translate('home.hero.bio')}
      </p>
    </div>
    <div class="flex shrink-0 items-center gap-1" aria-hidden="true">
      {/* Signature note (DESIGN.md v3 §5.3): the site's one aside that points
          at nothing but the Mac. English on both locales, ≤8 words, ink at
          60% — never bamboo. Hidden where the hero has no room for it. */}
      <div class="signature hidden md:flex">
        <span class="hand-note">{signature}</span>
        <svg
          class="signature-arrow"
          viewBox="0 0 64 36"
          width="64"
          height="36"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M2 24c8-14 20-19 34-14s20 8 26 12" />
          <path d="M54 14l8 8-11 2" />
        </svg>
      </div>
      <img
        src="/images/home/mac-light.webp"
        alt=""
        width="488"
        height="640"
        loading="eager"
        fetchpriority="high"
        class="h-24 w-auto select-none rounded-xl sm:h-28 dark:hidden"
        draggable="false"
      />
      <img
        src="/images/home/mac-dark.webp"
        alt=""
        width="488"
        height="640"
        loading="eager"
        class="hidden h-24 w-auto select-none rounded-xl sm:h-28 dark:block"
        draggable="false"
      />
    </div>
  </div>

  {/* Writing index, grouped by year */}
  <section class="mt-16">
    <h2 class="display-md">{translate('home.writing')}</h2>
    <div class="mt-5">
      <PostIndex posts={posts} lang={lang} />
    </div>
  </section>

  {/* Projects: objects on the desk (DESIGN.md v3 §5.1). The stage breaks out
      of the reading column; the label above stays on it. */}
  {
    projects.length > 0 && (
      <section class="mt-16">
        <h2 class="display-md">{translate('home.projects')}</h2>
        <div class="deck-breakout mt-3">
          <ProjectDeck projects={projects} href={projectHref} />
        </div>
      </section>
    )
  }

</div>

<style>
  /* Signature: the note tilts like a pencil aside; the arrow reaches the Mac. */
  .signature {
    align-items: flex-start;
    gap: 2px;
    margin-right: -6px;
    color: var(--color-ink-secondary);
  }
  .signature .hand-note {
    transform: rotate(-4deg) translateY(-2px);
    white-space: nowrap;
  }
  .signature-arrow {
    flex-shrink: 0;
    margin-top: 6px;
  }

  .group:hover .post-title {
    color: var(--color-accent);
  }

  /* Stage width (--container-stage) centred on the reading column. */
  .deck-breakout {
    width: min(var(--container-stage), 100vw - 3rem);
    margin-left: calc(50% - min(var(--container-stage), 100vw - 3rem) / 2);
  }

</style>
