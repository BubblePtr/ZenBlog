---
/**
 * Plain-text follow line (DESIGN.md "Ma"): icon + bold brand label inline.
 *
 * Keep the <a> as pure inline so the label shares the paragraph baseline with
 * surrounding CJK. Only the SVG is optically centered via vertical-align.
 *
 * Brand marks from Simple Icons (CC0): GitHub + X.
 * https://simpleicons.org/
 */
import type { Language } from '@/i18n/config';
import type { TranslationDictionary } from '@/shared/i18n/types';
import { getTranslationDictionary } from '@/shared/i18n/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t: TranslationDictionary = getTranslationDictionary(lang);

const linkClass =
  'follow-link text-zinc-800 no-underline transition-colors duration-150 hover:text-[var(--color-accent)] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)] dark:text-zinc-100';

// size ≈ cap height; -0.125em is the usual optical center for ~1em icons on body text
const iconClass = 'follow-icon mr-[0.28em] inline-block size-[1.05em] align-[-0.125em]';
---

<aside
  class:list={[
    // Match article body size (text-sm was UI scale; this line lives in the
    // reading surface so keep --font-size-body / prose rhythm).
    'mx-auto mt-16 w-full max-w-content px-6 text-base text-zinc-500 dark:text-zinc-400',
    lang === 'en' ? 'font-serif-en leading-[1.65]' : 'leading-relaxed',
  ]}
  aria-label={lang === 'zh' ? '关注作者' : 'Follow the author'}
>
  <p class="m-0">
    {t['blog.post.followCta.title']}
    {lang === 'zh' ? '在 ' : ' Follow on '}
    <a
      href="https://github.com/BubblePtr"
      target="_blank"
      rel="noopener noreferrer"
      class={linkClass}
    ><svg
      class={iconClass}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      ><!-- Simple Icons: GitHub --><path
        d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
      ></path></svg
    ><span class="font-semibold tracking-tight">{t['blog.post.followCta.github']}</span></a
    >
    {lang === 'zh' ? ' 或 ' : ' or '}
    <a
      href="https://twitter.com/ninthbit_ai"
      target="_blank"
      rel="noopener noreferrer"
      class={linkClass}
    ><svg
      class={iconClass}
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      focusable="false"
      ><!-- Simple Icons: X --><path
        d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
      ></path></svg
    ><span class="font-semibold tracking-tight">{t['blog.post.followCta.twitter']}</span></a
    >
    {
      lang === 'zh'
        ? ' 关注我，获取更多关于软件工程、AI 与独立开发的思考。'
        : ' for more on software engineering, AI, and indie building.'
    }
  </p>
</aside>
