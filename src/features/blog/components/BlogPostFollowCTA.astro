---
/**
 * Plain-text follow line (DESIGN.md "Ma"): one muted sentence with two
 * underlined links. Replaces the old gradient card CTA.
 */
import type { Language } from '@/i18n/config';
import type { TranslationDictionary } from '@/shared/i18n/types';
import { getTranslationDictionary } from '@/shared/i18n/types';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t: TranslationDictionary = getTranslationDictionary(lang);
---

<aside
  class="mx-auto mt-16 w-full max-w-content px-6 text-sm leading-6 text-zinc-500 dark:text-zinc-400"
  aria-label={lang === 'zh' ? '关注作者' : 'Follow the author'}
>
  <p class="m-0">
    {t['blog.post.followCta.title']}
    {lang === 'zh' ? '在 ' : 'Follow on '}<a
      href="https://github.com/BubblePtr"
      target="_blank"
      rel="noopener noreferrer"
      class="follow-link">{t['blog.post.followCta.github']}</a
    >{lang === 'zh' ? ' 或 ' : ' or '}<a
      href="https://twitter.com/ninthbit_ai"
      target="_blank"
      rel="noopener noreferrer"
      class="follow-link">{t['blog.post.followCta.twitter']}</a
    >{
      lang === 'zh'
        ? ' 关注我，获取更多关于软件工程、AI 与独立开发的思考。'
        : ' for more on software engineering, AI, and indie building.'
    }
  </p>
</aside>

<style>
  .follow-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
    transition: color 150ms ease;
  }
  .follow-link:hover {
    color: var(--color-accent);
  }
</style>
